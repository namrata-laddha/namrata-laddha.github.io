@misc{thorat2024rocket,
  abbr         = {Preprint},
  title        = {Design and Development of a Model Rocket with Recovery System and Thrust Vectoring for Enhanced Performance and Stability},
  author       = {Thorat, Shreyash and Laddha, Namrata and Mehendale, Ninad and Nikam, Shailesh R.},
  year         = {2024},
  publisher    = {SSRN},
  howpublished = {SSRN preprint 5370133},
  abstract     = {This paper presents the design, development, and testing of an advanced model rocket incorporating active thrust vectoring and an integrated recovery system. The design features a reusable combustion chamber, an interchangeable fin can, and KNSB (potassium nitrate sorbitol) as a solid propellant. Key contributions include a dual-servo thrust vectoring mechanism controlled by an MPU6050 gyroscope, a hexagonal parachute with servo-actuated deployment, and a custom Arduino-based flight computer. The rocket achieves a maximum thrust of 384 N and a total impulse of 320 N-s. Experimental results validate the effectiveness of the thrust vectoring system in maintaining flight stability and the reliability of the recovery system.},
  html         = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5370133},
  selected     = {true},
  bibtex_show  = {true}
}

@misc{laddha2023drone,
  abbr         = {Preprint},
  title        = {Improving Drone Efficiency for Emergency Package Delivery through Payload Optimization and Traffic Avoidance},
  author       = {Laddha, Namrata and Bhattacharjee, Swapnil and Dekate, Om and Mehendale, Ninad},
  year         = {2023},
  month        = {May},
  publisher    = {SSRN},
  howpublished = {SSRN preprint 4443916},
  abstract     = {This study improves drone efficiency for emergency package delivery through payload optimization and traffic avoidance. By modifying the drone design to carry more payload, the platform can deliver small packages such as food, letters, and medicine over short distances. Payload optimization considers the weight of the drone and its components, reducing mass through lighter materials and a streamlined design; routing is planned to avoid congested airspace and obstacles using advanced navigation and real-time traffic monitoring. Together these changes extend flight time, reduce energy consumption, and improve the speed and safety of emergency delivery.},
  html         = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4443916},
  selected     = {true},
  bibtex_show  = {true}
}
